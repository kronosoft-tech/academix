---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import { actions } from "astro:actions";

const result = Astro.getActionResult(actions.passwordReset);
---

<Base title="Restablecer Contraseña">
  <div class="flex items-center justify-center min-h-[calc(100vh-12rem)] px-4">
    <div class="w-full max-w-md">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8">
        <h1 class="text-2xl font-bold text-white mb-2">Restablecer Contraseña</h1>
        <p class="text-slate-400 mb-6">
          Ingresa tu email y te enviaremos un enlace para restablecer tu contraseña
        </p>

        {result && !result.error && (
          <div class="mb-4 p-3 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm">
            {result.data.message}
          </div>
        )}

        {result?.error && (
          <div class="mb-4 p-3 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 text-sm">
            {result.error.message}
          </div>
        )}

        <form method="POST" action={actions.passwordReset} class="space-y-4">
          <div>
            <label for="email" class="block text-sm font-medium text-slate-300 mb-1">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
              placeholder="tu@email.com"
            />
          </div>

          <button
            type="submit"
            class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-medium rounded-lg transition-colors"
          >
            Enviar enlace
          </button>
        </form>

        <div class="mt-6 text-center text-sm text-slate-400">
          <p>
            <a href="/auth/login" class="text-emerald-400 hover:text-emerald-300">
              Volver al inicio de sesión
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</Base>
