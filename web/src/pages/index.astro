---
import Navbar from '../components/landing/Navbar';
import LandingPage from '../components/landing/LandingPage';
import Seo from '../components/Seo.astro';

export const prerender = true;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Academix - La plataforma de gestión académica que simplifica la administración para instituciones educativas en Latinoamérica." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>Academix — Gestión académica simple y poderosa</title>
    <Seo
      title="Academix — Gestión académica simple y poderosa"
      description="La plataforma de gestión académica que simplifica la administración para instituciones educativas en Latinoamérica."
    />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { background-color: #09090b; }
    </style>
  </head>
  <body>
    <Navbar client:visible />
    <LandingPage />
  </body>
</html>
