---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const tutorials = await getCollection('tutorials');
  return tutorials.map((tutorial) => ({
    params: { slug: tutorial.id },
    props: { tutorial },
  }));
}

const { tutorial } = Astro.props;
const { Content } = await render(tutorial);
---

<Base title={tutorial.data.title} description={tutorial.data.description}>
  <article class="py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="mb-8">
        <a href="/tutorials" class="text-sm text-emerald-400 hover:text-emerald-300 transition-colors">
          &larr; Volver a tutoriales
        </a>
      </nav>
      <h1 class="text-3xl font-bold mb-4">{tutorial.data.title}</h1>
      <p class="text-slate-400 mb-8">{tutorial.data.description}</p>
      <div class="prose prose-invert prose-emerald max-w-none">
        <Content />
      </div>
    </div>
  </article>
</Base>
