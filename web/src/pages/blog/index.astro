---
import Base from '../../layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export const prerender = true;

const allPosts = await getCollection('blog');
const published = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const pillar = published.find((post) => post.data.isPillar) ?? null;
const articles = published.filter((post) => !post.data.isPillar);

interface TagGroup {
  tag: string;
  posts: CollectionEntry<'blog'>[];
}

// Group by topic cluster (all tags); each group newest-first, groups ordered
// by their most recent post so the listing reads newest-first overall.
const groups: TagGroup[] = [];
for (const post of articles) {
  for (const tag of post.data.tags) {
    let group = groups.find((g) => g.tag === tag);
    if (!group) {
      group = { tag, posts: [] };
      groups.push(group);
    }
    group.posts.push(post);
  }
}
for (const group of groups) {
  group.posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
}
groups.sort((a, b) => b.posts[0].data.pubDate.getTime() - a.posts[0].data.pubDate.getTime());

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title="Blog" description="Artículos sobre gestión académica para academias: estudiantes, cursos, pagos, asistencia y reportes.">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <header class="mb-12 text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-emerald-400">Blog Academix</p>
        <h1 class="mt-3 text-3xl font-bold text-white sm:text-4xl">Gestión académica, explicada</h1>
        <p class="mx-auto mt-4 max-w-2xl text-slate-400">
          Guías y artículos prácticos para ordenar la administración de tu academia:
          inscripciones, pagos, asistencia, reportes y retención de estudiantes.
        </p>
      </header>

      {published.length === 0 && (
        <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-12 text-center">
          <p class="text-slate-400">Aún no hay artículos publicados. Vuelve pronto.</p>
        </div>
      )}

      {pillar && (
        <a
          href={`/blog/${pillar.id}`}
          class="mb-14 block rounded-2xl border border-emerald-800/40 bg-gradient-to-r from-emerald-950/70 to-slate-900/70 p-8 transition-colors hover:border-emerald-700"
        >
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400">Guía principal</p>
          <h2 class="mt-2 text-2xl font-bold text-white">{pillar.data.title}</h2>
          <p class="mt-3 text-slate-300">{pillar.data.description}</p>
          <p class="mt-4 text-sm font-semibold text-emerald-400">Leer la guía completa &rarr;</p>
        </a>
      )}

      {groups.length > 0 && (
        <div class="mb-12 flex flex-wrap justify-center gap-2">
          {groups.map(({ tag }) => (
            <a
              href={`#tema-${tag}`}
              class="rounded-full border border-slate-700 px-4 py-1.5 text-sm text-slate-300 transition-colors hover:border-emerald-700 hover:text-emerald-300"
            >
              {tag}
            </a>
          ))}
        </div>
      )}

      {groups.map(({ tag, posts }) => (
        <section key={tag} id={`tema-${tag}`} class="mb-14 scroll-mt-24">
          <h2 class="mb-6 text-xl font-semibold text-emerald-400">{tag}</h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <a
                href={`/blog/${post.id}`}
                class="flex flex-col rounded-xl border border-slate-800 bg-slate-900/50 p-5 transition-colors hover:border-emerald-700"
              >
                <time datetime={post.data.pubDate.toISOString()} class="text-xs text-slate-500">
                  {formatDate(post.data.pubDate)}
                </time>
                <h3 class="mt-2 font-semibold leading-snug text-white">{post.data.title}</h3>
                <p class="mt-2 line-clamp-3 text-sm text-slate-400">{post.data.description}</p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</Base>