---
import Base from '../../layouts/Base.astro';
import CtaBlock from '../../components/blog/CtaBlock.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { extractHeadings } from '../../lib/headings';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const published = posts.filter((post) => !post.data.draft);
  return published.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const isPillar = post.data.isPillar;

const allPosts = await getCollection('blog');
const published = allPosts.filter((p) => !p.data.draft);
const pillar = published.find((p) => p.data.isPillar) ?? null;

// Related posts: share at least one tag, exclude the current post, max 3.
const related = published
  .filter((p) => p.id !== post.id && p.data.tags.some((tag) => post.data.tags.includes(tag)))
  .sort(
    (a, b) =>
      b.data.tags.filter((tag) => post.data.tags.includes(tag)).length -
        a.data.tags.filter((tag) => post.data.tags.includes(tag)).length ||
      b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  )
  .slice(0, 3);

const toc = isPillar
  ? null
  : extractHeadings(post.body);

const pillarClusters = isPillar
  ? published.filter((p) => !p.data.isPillar).sort((a, b) => a.data.pubDate.getTime() - b.data.pubDate.getTime())
  : [];

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title={post.data.title} description={post.data.description}>
  <Fragment slot="head">
    <link rel="alternate" type="text/markdown" href={`/blog/${post.id}.md`} />
  </Fragment>

  <article class="py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <nav class="mb-8">
        <a href="/blog" class="text-sm text-emerald-400 transition-colors hover:text-emerald-300">
          &larr; Volver al blog
        </a>
      </nav>

      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-3 text-sm">
          <time datetime={post.data.pubDate.toISOString()} class="text-slate-500">
            {formatDate(post.data.pubDate)}
          </time>
          <span class="text-slate-600">&middot;</span>
          <span class="text-slate-400">{post.data.author}</span>
          {isPillar && (
            <span class="rounded-full border border-emerald-700/50 px-3 py-0.5 text-xs font-semibold text-emerald-400">
              Guía principal
            </span>
          )}
        </div>
        <h1 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-4xl">{post.data.title}</h1>
        <p class="mt-4 text-lg text-slate-400">{post.data.description}</p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <li>
              <span class="rounded-full border border-slate-700 px-3 py-1 text-xs text-slate-300">{tag}</span>
            </li>
          ))}
        </ul>
      </header>

      {toc && toc.length > 0 && (
        <nav class="mb-10 rounded-xl border border-slate-800 bg-slate-900/50 p-6" aria-label="Tabla de contenidos">
          <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-emerald-400">Contenido</p>
          <ol class="space-y-2">
            {toc.map((heading) => (
              <li class={heading.depth === 3 ? 'pl-4' : ''}>
                <a href={`#${heading.id}`} class="text-sm text-slate-300 transition-colors hover:text-emerald-300">
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      {isPillar && pillarClusters.length > 0 && (
        <nav class="mb-10 rounded-xl border border-emerald-800/40 bg-emerald-950/30 p-6" aria-label="Temas de la guía">
          <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-emerald-400">Temas de esta guía</p>
          <ol class="space-y-2">
            {pillarClusters.map((cluster) => (
              <li>
                <a href={`/blog/${cluster.id}`} class="text-sm text-slate-200 transition-colors hover:text-emerald-300">
                  {cluster.data.title}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="prose prose-invert prose-emerald max-w-none">
        <Content />
      </div>

      {!isPillar && pillar && (
        <div class="mt-12 rounded-xl border border-slate-800 bg-slate-900/50 p-6">
          <p class="text-sm font-semibold uppercase tracking-widest text-emerald-400">Guía principal</p>
          <a href={`/blog/${pillar.id}`} class="mt-2 block font-semibold text-white transition-colors hover:text-emerald-300">
            {pillar.data.title}
          </a>
          <p class="mt-1 text-sm text-slate-400">{pillar.data.description}</p>
        </div>
      )}

      <CtaBlock />

      {related.length > 0 && (
        <section class="mt-14">
          <h2 class="mb-6 text-xl font-semibold text-white">Artículos relacionados</h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((item) => (
              <a
                href={`/blog/${item.id}`}
                class="flex flex-col rounded-xl border border-slate-800 bg-slate-900/50 p-5 transition-colors hover:border-emerald-700"
              >
                <time datetime={item.data.pubDate.toISOString()} class="text-xs text-slate-500">
                  {formatDate(item.data.pubDate)}
                </time>
                <h3 class="mt-2 text-sm font-semibold leading-snug text-white">{item.data.title}</h3>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</Base>