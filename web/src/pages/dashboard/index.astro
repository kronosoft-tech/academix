---
export const prerender = false;

import Dashboard from "../../layouts/Dashboard.astro";
import DashboardCharts from "../../components/DashboardCharts.tsx";
import { getFullTokenPayload } from "../../lib/auth";
import { getUserDb } from "../../lib/user-db";
import { db } from "../../lib/db";
import { getOrCreateTrialSubscription } from "../../lib/payments/lifecycle";
import { activateApprovedPayment } from "../../lib/payments/mercadopago";

const payload = await getFullTokenPayload(Astro.cookies);
if (!payload) {
  return Astro.redirect("/auth/login");
}

// Handle payment redirect from Wompi (they add ?id=TRANSACTION_ID)
const url = new URL(Astro.request.url);
const wompiTransactionId = url.searchParams.get("id");
let paymentSuccess = false;
let paymentError = "";

if (wompiTransactionId) {
  // Verify the transaction and activate subscription
  const WOMPI_API_URL =
    import.meta.env.WOMPI_API_URL || "https://production.wompi.co/v1";
  const WOMPI_PUBLIC_KEY = import.meta.env.WOMPI_PUBLIC_KEY || "";
  try {
    const txRes = await fetch(
      `${WOMPI_API_URL}/transactions/${wompiTransactionId}`,
      {
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${WOMPI_PUBLIC_KEY}`,
        },
      },
    );
    if (txRes.ok) {
      const txData = await txRes.json();
      const transaction = txData.data;

      if (transaction.status === "APPROVED") {
        const reference = transaction.reference || "";
        const parts = reference.split("-");
        const txUserId = parts.slice(0, 5).join("-");
        const planId = parts.length >= 6 ? parts[5] : "basico";

        if (txUserId !== payload.sub) {
          paymentError = "Este pago no corresponde a tu cuenta.";
        } else {
          // Get (or lazily create for desktop-first users) the trial row
          const sub = await getOrCreateTrialSubscription(payload.sub, planId);
          const subscriptionId = sub.id;
          const now = new Date().toISOString();
          const periodEnd = new Date(
            Date.now() + 30 * 24 * 60 * 60 * 1000,
          ).toISOString();

          // Activate subscription
          await db.execute({
            sql: `UPDATE subscriptions
                  SET status = 'active', provider = 'wompi',
                      provider_subscription_id = ?, payment_source_token = ?,
                      plan_id = ?, trial_end = NULL, trial_starts_at = NULL,
                      grace_expires_at = NULL,
                      current_period_start = ?, current_period_end = ?,
                      updated_at = ?
                  WHERE id = ?`,
            args: [
              reference,
              transaction.payment_source_id?.toString() || null,
              planId,
              now,
              periodEnd,
              now,
              subscriptionId,
            ],
          });

          // Record payment (idempotent)
          const existingPay = await db.execute({
            sql: "SELECT id FROM subscription_payments WHERE provider_payment_id = ?",
            args: [transaction.id],
          });
          if (existingPay.rows.length === 0) {
            await db.execute({
              sql: `INSERT INTO subscription_payments (id, user_id, subscription_id, amount, currency, status, provider, provider_payment_id, created_at)
                    VALUES (?, ?, ?, ?, ?, ?, 'wompi', ?, ?)`,
              args: [
                crypto.randomUUID(),
                payload.sub,
                subscriptionId,
                transaction.amount_in_cents / 100,
                transaction.currency || "COP",
                "succeeded",
                transaction.id,
                now,
              ],
            });
          }
          paymentSuccess = true;
        }
      } else if (transaction.status === "PENDING") {
        paymentError =
          "Tu pago está siendo procesado. Te notificaremos cuando se confirme.";
      } else {
        paymentError = `El pago fue ${transaction.status === "DECLINED" ? "rechazado" : "cancelado"}. Intenta de nuevo.`;
      }
    }
  } catch (err) {
    console.error(
      `[DASHBOARD] Wompi transaction verification failed for ${wompiTransactionId}:`,
      err,
    );
    // Webhook will handle activation
  }
}

// Handle payment redirect from Mercado Pago Checkout Pro. Checkout Pro appends
// ?payment_id=...&status=approved&external_reference=... to the success URL
// (not preapproval_id — the preapproval API is not supported in Colombia).
const mpPaymentId =
  url.searchParams.get("payment_id") || url.searchParams.get("collection_id");
const mpStatus = url.searchParams.get("status");
if (mpPaymentId && !paymentSuccess) {
  const MP_API_URL =
    import.meta.env.MP_API_URL || "https://api.mercadopago.com";
  const MP_ACCESS_TOKEN = import.meta.env.MP_ACCESS_TOKEN || "";
  try {
    const mpRes = await fetch(`${MP_API_URL}/v1/payments/${mpPaymentId}`, {
      headers: {
        Authorization: `Bearer ${MP_ACCESS_TOKEN}`,
        "Content-Type": "application/json",
      },
    });
    if (mpRes.ok) {
      const mpData = await mpRes.json();
      if (mpData.status === "approved" && mpData.external_reference) {
        await activateApprovedPayment({
          paymentId: mpPaymentId,
          externalReference: mpData.external_reference,
          transactionAmount: mpData.transaction_amount,
          currencyId: mpData.currency_id || "COP",
        });
        paymentSuccess = true;
      } else if (mpData.status === "pending") {
        paymentError =
          "Tu pago está siendo procesado. Te notificaremos cuando se confirme.";
      } else if (mpData.status !== "approved" && mpStatus === "approved") {
        // Approve confirmed by MP but details not returned — webhook will
        // complete the activation.
        paymentError =
          "Tu pago se está procesando. Te notificaremos cuando se confirme.";
      } else {
        paymentError = `El pago fue ${mpData.status === "rejected" ? "rechazado" : "cancelado"}. Intenta de nuevo.`;
      }
    }
  } catch (err) {
    console.error(
      `[DASHBOARD] MercadoPago payment verification failed for ${mpPaymentId}:`,
      err,
    );
    paymentError =
      "No pudimos verificar tu pago. Te notificaremos por webhook cuando se confirme.";
  }
}

const userDb = getUserDb(payload);

let totalStudents = 0;
let totalCourses = 0;
let totalGroups = 0;
let totalIncome = 0;
let pendingPayments = 0;
let recentPayments: {
  student_name: string;
  amount: number;
  status: string;
  created_at: string;
}[] = [];
let dbError = false;

try {
  const [studentsRes, coursesRes, groupsRes, incomeRes, pendingRes, recentRes] =
    await Promise.all([
      userDb.execute("SELECT COUNT(*) as count FROM students"),
      userDb.execute("SELECT COUNT(*) as count FROM courses"),
      userDb.execute("SELECT COUNT(*) as count FROM groups_table"),
      userDb.execute(
        "SELECT COALESCE(SUM(CAST(amount AS REAL)), 0) as total FROM payments WHERE status = 'paid'",
      ),
      userDb.execute(
        "SELECT COALESCE(SUM(CAST(amount AS REAL)), 0) as total FROM payments WHERE status = 'pending'",
      ),
      userDb.execute(
        `SELECT s.first_name || ' ' || s.last_name as student_name, p.amount, p.status, p.created_at
       FROM payments p
       JOIN students s ON p.student_id = s.id
       ORDER BY p.created_at DESC LIMIT 5`,
      ),
    ]);

  totalStudents = Number(studentsRes.rows[0]?.count ?? 0);
  totalCourses = Number(coursesRes.rows[0]?.count ?? 0);
  totalGroups = Number(groupsRes.rows[0]?.count ?? 0);
  totalIncome = Number(incomeRes.rows[0]?.total ?? 0);
  pendingPayments = Number(pendingRes.rows[0]?.total ?? 0);
  recentPayments = recentRes.rows.map((r) => ({
    student_name: r.student_name as string,
    amount: Number(r.amount),
    status: r.status as string,
    created_at: r.created_at as string,
  }));
} catch {
  dbError = true;
}

const isEmpty =
  !dbError &&
  totalStudents === 0 &&
  totalCourses === 0 &&
  totalGroups === 0 &&
  totalIncome === 0 &&
  pendingPayments === 0;

// Build chart data: monthly income for last 6 months
let chartData: { label: string; value: number }[] = [];
if (!dbError && !isEmpty) {
  try {
    const now = new Date();
    const months: { label: string; start: string; end: string }[] = [];
    for (let i = 5; i >= 0; i--) {
      const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
      const end = new Date(d.getFullYear(), d.getMonth() + 1, 0);
      months.push({
        label: d.toLocaleDateString("es-CO", {
          month: "short",
          year: "2-digit",
        }),
        start: d.toISOString().slice(0, 10),
        end: end.toISOString().slice(0, 10),
      });
    }

    for (const m of months) {
      const res = await userDb.execute({
        sql: `SELECT COALESCE(SUM(CAST(amount AS REAL)), 0) as total
              FROM payments
              WHERE status = 'paid' AND created_at >= ? AND created_at <= ?`,
        args: [m.start, m.end + "T23:59:59"],
      });
      chartData.push({
        label: m.label,
        value: Number(res.rows[0]?.total ?? 0),
      });
    }
  } catch {
    chartData = [];
  }
}

const formatCurrency = (value: number) =>
  new Intl.NumberFormat("es-CO", {
    style: "currency",
    currency: "COP",
    minimumFractionDigits: 0,
  }).format(value);

const statusColors: Record<string, string> = {
  paid: "bg-emerald-500/20 text-emerald-400",
  pending: "bg-amber-500/20 text-amber-400",
  overdue: "bg-red-500/20 text-red-400",
  cancelled: "bg-slate-500/20 text-slate-400",
};

const statusLabels: Record<string, string> = {
  paid: "Pagado",
  pending: "Pendiente",
  overdue: "Vencido",
  cancelled: "Cancelado",
};
---

<Dashboard title="Panel de Control">
  <div class="max-w-6xl">
    <h1 class="text-2xl font-bold text-white mb-6">Panel de Control</h1>

    {
      paymentSuccess && (
        <div class="mb-6 p-4 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
          <p class="font-medium">🎉 ¡Pago exitoso!</p>
          <p class="text-sm mt-1">
            Tu suscripción ha sido activada. ¡Disfruta de Academix!
          </p>
        </div>
      )
    }

    {
      paymentError && (
        <div class="mb-6 p-4 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-400">
          <p class="font-medium">⚠️ Estado del pago</p>
          <p class="text-sm mt-1">{paymentError}</p>
        </div>
      )
    }

    {
      dbError && (
        <div class="mb-6 p-4 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400">
          <p class="font-medium">Error de conexión</p>
          <p class="text-sm mt-1">
            No pudimos conectar con tu base de datos. Verifica que tu academia
            esté configurada correctamente.
          </p>
        </div>
      )
    }

    {
      isEmpty && (
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-8 text-center">
          <div class="max-w-md mx-auto">
            <div class="w-16 h-16 bg-emerald-500/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg
                class="w-8 h-8 text-emerald-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                />
              </svg>
            </div>
            <h2 class="text-lg font-semibold text-white mb-2">
              Tu academia está lista
            </h2>
            <p class="text-slate-400 mb-6">
              Descarga la app de escritorio para empezar a gestionar tu academia
            </p>
            <a
              href="/download"
              class="inline-block px-6 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-medium rounded-lg transition-colors"
            >
              Descargar App
            </a>
          </div>
        </div>
      )
    }

    {
      !dbError && !isEmpty && (
        <>
          {/* Metric Cards */}
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
              <p class="text-sm text-slate-400 mb-1">Estudiantes</p>
              <p class="text-2xl font-bold text-white">{totalStudents}</p>
            </div>
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
              <p class="text-sm text-slate-400 mb-1">Cursos</p>
              <p class="text-2xl font-bold text-white">{totalCourses}</p>
            </div>
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
              <p class="text-sm text-slate-400 mb-1">Grupos</p>
              <p class="text-2xl font-bold text-white">{totalGroups}</p>
            </div>
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
              <p class="text-sm text-slate-400 mb-1">Ingresos (pagados)</p>
              <p class="text-2xl font-bold text-emerald-400">
                {formatCurrency(totalIncome)}
              </p>
            </div>
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
              <p class="text-sm text-slate-400 mb-1">Pagos pendientes</p>
              <p class="text-2xl font-bold text-amber-400">
                {formatCurrency(pendingPayments)}
              </p>
            </div>
          </div>

          {/* Charts */}
          {chartData.length > 0 && (
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 mb-8">
              <h2 class="text-lg font-semibold text-white mb-4">
                Ingresos mensuales
              </h2>
              <DashboardCharts client:load data={chartData} />
            </div>
          )}

          {/* Recent Payments */}
          {recentPayments.length > 0 && (
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
              <h2 class="text-lg font-semibold text-white mb-4">
                Pagos recientes
              </h2>
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="text-slate-400 border-b border-slate-800">
                      <th class="text-left py-2">Estudiante</th>
                      <th class="text-left py-2">Monto</th>
                      <th class="text-left py-2">Estado</th>
                      <th class="text-left py-2">Fecha</th>
                    </tr>
                  </thead>
                  <tbody>
                    {recentPayments.map((payment) => (
                      <tr class="border-b border-slate-800/50">
                        <td class="py-3 text-white">{payment.student_name}</td>
                        <td class="py-3 text-white">
                          {formatCurrency(payment.amount)}
                        </td>
                        <td class="py-3">
                          <span
                            class={`px-2 py-0.5 rounded text-xs ${statusColors[payment.status] || "bg-slate-700 text-slate-300"}`}
                          >
                            {statusLabels[payment.status] || payment.status}
                          </span>
                        </td>
                        <td class="py-3 text-slate-400">
                          {new Date(payment.created_at).toLocaleDateString(
                            "es-CO",
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </>
      )
    }
  </div>
</Dashboard>
