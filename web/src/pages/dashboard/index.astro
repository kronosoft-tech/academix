---
export const prerender = false;

import Dashboard from "../../layouts/Dashboard.astro";
import { db } from "../../lib/db";

const user = Astro.locals.user!;

// Fetch active subscription
const subscriptionResult = await db.execute({
  sql: `SELECT id, plan, status, trial_end, grace_end, current_period_end, created_at
        FROM subscriptions
        WHERE user_id = ? AND status IN ('trial', 'active', 'grace')
        ORDER BY created_at DESC LIMIT 1`,
  args: [user.id],
});

const subscription = subscriptionResult.rows[0] || null;

// Fetch payment history
const paymentsResult = await db.execute({
  sql: `SELECT id, amount, currency, status, provider, created_at
        FROM subscription_payments
        WHERE user_id = ?
        ORDER BY created_at DESC LIMIT 10`,
  args: [user.id],
});

const payments = paymentsResult.rows;

// Check expiration alert (within 7 days)
let expirationAlert = false;
if (subscription?.current_period_end) {
  const periodEnd = new Date(subscription.current_period_end as string);
  const now = new Date();
  const daysUntilExpiry = Math.ceil((periodEnd.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
  expirationAlert = daysUntilExpiry <= 7 && daysUntilExpiry > 0;
}

const statusLabels: Record<string, string> = {
  trial: 'Prueba Gratuita',
  active: 'Activa',
  grace: 'Período de Gracia',
  expired: 'Expirada',
  cancelled: 'Cancelada',
};

const statusColors: Record<string, string> = {
  trial: 'bg-blue-500/20 text-blue-400',
  active: 'bg-emerald-500/20 text-emerald-400',
  grace: 'bg-amber-500/20 text-amber-400',
  expired: 'bg-red-500/20 text-red-400',
  cancelled: 'bg-slate-500/20 text-slate-400',
};
---

<Dashboard title="Mi Dashboard">
  <div class="max-w-4xl">
    <h1 class="text-2xl font-bold text-white mb-6">Bienvenido, {user.email}</h1>

    {expirationAlert && (
      <div class="mb-6 p-4 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-400">
        <p class="font-medium">Tu suscripción vence pronto</p>
        <p class="text-sm mt-1">Renueva para no perder acceso a la aplicación de escritorio.</p>
      </div>
    )}

    {subscription ? (
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 mb-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-white">Suscripción</h2>
          <span class={`px-3 py-1 rounded-full text-xs font-medium ${statusColors[subscription.status as string] || 'bg-slate-700 text-slate-300'}`}>
            {statusLabels[subscription.status as string] || subscription.status}
          </span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div>
            <p class="text-slate-400">Plan</p>
            <p class="text-white font-medium capitalize">{subscription.plan}</p>
          </div>
          {subscription.current_period_end && (
            <div>
              <p class="text-slate-400">Próxima facturación</p>
              <p class="text-white font-medium">
                {new Date(subscription.current_period_end as string).toLocaleDateString('es-CO')}
              </p>
            </div>
          )}
        </div>
      </div>
    ) : (
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 mb-6 text-center">
        <p class="text-slate-400 mb-4">No tienes una suscripción activa</p>
        <a
          href="/pricing"
          class="inline-block px-6 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-medium rounded-lg transition-colors"
        >
          Ver planes
        </a>
      </div>
    )}

    {payments.length > 0 && (
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
        <h2 class="text-lg font-semibold text-white mb-4">Historial de Pagos</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-slate-400 border-b border-slate-800">
                <th class="text-left py-2">Fecha</th>
                <th class="text-left py-2">Monto</th>
                <th class="text-left py-2">Estado</th>
                <th class="text-left py-2">Proveedor</th>
              </tr>
            </thead>
            <tbody>
              {payments.map((payment) => (
                <tr class="border-b border-slate-800/50">
                  <td class="py-3 text-white">
                    {new Date(payment.created_at as string).toLocaleDateString('es-CO')}
                  </td>
                  <td class="py-3 text-white">
                    {payment.currency} ${Number(payment.amount).toLocaleString()}
                  </td>
                  <td class="py-3">
                    <span class={`px-2 py-0.5 rounded text-xs ${payment.status === 'succeeded' ? 'bg-emerald-500/20 text-emerald-400' : payment.status === 'failed' ? 'bg-red-500/20 text-red-400' : 'bg-slate-700 text-slate-300'}`}>
                      {payment.status}
                    </span>
                  </td>
                  <td class="py-3 text-slate-400 capitalize">{payment.provider}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>
</Dashboard>
