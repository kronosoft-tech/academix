---
export const prerender = false;

import Dashboard from "../../layouts/Dashboard.astro";
import { getFullTokenPayload } from "../../lib/auth";
import { db } from "../../lib/db";
import { PLANS } from "../../data/plans";

const payload = await getFullTokenPayload(Astro.cookies);
if (!payload) {
  return Astro.redirect("/auth/login");
}

let subscription: Record<string, unknown> | null = null;

try {
  const result = await db.execute({
    sql: `SELECT * FROM subscriptions WHERE user_id = ? ORDER BY created_at DESC LIMIT 1`,
    args: [payload.sub],
  });
  subscription = result.rows[0] ? (result.rows[0] as Record<string, unknown>) : null;
} catch {
  // Table may not exist yet
}

const plan = subscription ? PLANS.find((p) => p.id === subscription!.plan_id) : null;
const status = subscription?.status as string | undefined;
const isTrial = status === "trial";
const isActive = status === "active";
const isPremium = plan?.id === "premium";

const statusLabels: Record<string, string> = {
  trial: "Prueba Gratuita",
  active: "Activa",
  grace: "Período de Gracia",
  expired: "Expirada",
  cancelled: "Cancelada",
};

const statusColors: Record<string, string> = {
  trial: "bg-blue-500/20 text-blue-400",
  active: "bg-emerald-500/20 text-emerald-400",
  grace: "bg-amber-500/20 text-amber-400",
  expired: "bg-red-500/20 text-red-400",
  cancelled: "bg-slate-500/20 text-slate-400",
};
---

<Dashboard title="Suscripción">
  <div class="max-w-3xl">
    <h1 class="text-2xl font-bold text-white mb-6">Suscripción</h1>

    {!subscription && (
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-8 text-center">
        <div class="max-w-sm mx-auto">
          <p class="text-slate-400 mb-6">No tienes suscripción activa</p>
          <a
            href="/pricing"
            class="inline-block px-6 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-medium rounded-lg transition-colors"
          >
            Ver planes
          </a>
        </div>
      </div>
    )}

    {subscription && isTrial && (
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-lg font-semibold text-white">Período de prueba</h2>
          <span class={`px-3 py-1 rounded-full text-xs font-medium ${statusColors.trial}`}>
            {statusLabels.trial}
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
          <div>
            <p class="text-sm text-slate-400">Finaliza</p>
            <p class="text-white font-medium">
              {subscription.trial_end
                ? new Date(subscription.trial_end as string).toLocaleDateString("es-CO", { year: "numeric", month: "long", day: "numeric" })
                : "—"}
            </p>
          </div>
          <div>
            <p class="text-sm text-slate-400">Acceso</p>
            <p class="text-white font-medium">Todas las funciones disponibles</p>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-800">
          <p class="text-sm text-slate-400 mb-3">Elige un plan para continuar después de tu prueba:</p>
          <a
            href="/pricing"
            class="inline-block px-6 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-medium rounded-lg transition-colors"
          >
            Elegir plan
          </a>
        </div>
      </div>
    )}

    {subscription && (isActive || status === "grace") && !isTrial && (
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-lg font-semibold text-white">Tu plan</h2>
          <span class={`px-3 py-1 rounded-full text-xs font-medium ${statusColors[status!] || "bg-slate-700 text-slate-300"}`}>
            {statusLabels[status!] || status}
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
          <div>
            <p class="text-sm text-slate-400">Plan</p>
            <p class="text-white font-medium text-lg">{plan?.name || subscription.plan_id}</p>
          </div>
          {subscription.current_period_end && (
            <div>
              <p class="text-sm text-slate-400">Próxima facturación</p>
              <p class="text-white font-medium">
                {new Date(subscription.current_period_end as string).toLocaleDateString("es-CO", { year: "numeric", month: "long", day: "numeric" })}
              </p>
            </div>
          )}
        </div>

        {plan && (
          <div class="bg-slate-950 rounded-lg p-4 mb-6">
            <p class="text-sm text-slate-400 mb-2">Límites de tu plan</p>
            <div class="grid grid-cols-2 gap-3 text-sm">
              <div>
                <p class="text-slate-400">Estudiantes</p>
                <p class="text-white font-medium">{plan.maxStudents ?? "Ilimitados"}</p>
              </div>
              <div>
                <p class="text-slate-400">Usuarios</p>
                <p class="text-white font-medium">{plan.maxUsers ?? "Ilimitados"}</p>
              </div>
            </div>
          </div>
        )}

        {!isPremium && (
          <div class="pt-4 border-t border-slate-800">
            <p class="text-sm text-slate-400 mb-3">¿Necesitas más capacidad?</p>
            <a
              href="/pricing"
              class="inline-block px-6 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-medium rounded-lg transition-colors"
            >
              Mejorar plan
            </a>
          </div>
        )}
      </div>
    )}
  </div>
</Dashboard>
