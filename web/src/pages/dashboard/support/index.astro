---
export const prerender = false;

import Dashboard from "../../../layouts/Dashboard.astro";
import { db } from "../../../lib/db";

const user = Astro.locals.user!;

const result = await db.execute({
  sql: `SELECT id, type, subject, status, created_at, resolved_at
        FROM pqrs_tickets
        WHERE user_id = ?
        ORDER BY created_at DESC`,
  args: [user.id],
});

const tickets = result.rows;

const typeLabels: Record<string, string> = {
  petition: 'Petición',
  complaint: 'Queja',
  claim: 'Reclamo',
  suggestion: 'Sugerencia',
};

const statusConfig: Record<string, { label: string; color: string }> = {
  open: { label: 'Abierto', color: 'bg-amber-500/20 text-amber-400' },
  in_progress: { label: 'En proceso', color: 'bg-blue-500/20 text-blue-400' },
  resolved: { label: 'Resuelto', color: 'bg-emerald-500/20 text-emerald-400' },
};
---

<Dashboard title="Soporte">
  <div class="max-w-4xl">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-white">Soporte</h1>
      <div class="flex gap-3">
        <a
          href="/dashboard/support/chat"
          class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-lg text-sm font-medium transition-colors"
        >
          Chat con IA
        </a>
        <a
          href="/dashboard/support/new"
          class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-sm font-medium transition-colors"
        >
          Nuevo ticket
        </a>
      </div>
    </div>

    {tickets.length === 0 ? (
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-8 text-center">
        <p class="text-slate-400">No tienes tickets de soporte</p>
        <p class="text-sm text-slate-500 mt-2">
          Crea un ticket o usa el chat con IA para obtener ayuda.
        </p>
      </div>
    ) : (
      <div class="space-y-3">
        {tickets.map((ticket) => (
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
            <div class="flex items-start justify-between">
              <div>
                <h3 class="text-white font-medium">{ticket.subject}</h3>
                <p class="text-sm text-slate-400 mt-1">
                  {typeLabels[ticket.type as string] || ticket.type} &middot;{" "}
                  {new Date(ticket.created_at as string).toLocaleDateString('es-CO')}
                </p>
              </div>
              <span
                class={`px-3 py-1 rounded-full text-xs font-medium ${statusConfig[ticket.status as string]?.color || 'bg-slate-700 text-slate-300'}`}
              >
                {statusConfig[ticket.status as string]?.label || ticket.status}
              </span>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</Dashboard>
