---
export const prerender = false;

import Dashboard from "../../../layouts/Dashboard.astro";
import { actions } from "astro:actions";

const result = Astro.getActionResult(actions.pqrs.createTicket);
if (result && !result.error) {
  return Astro.redirect('/dashboard/support');
}
---

<Dashboard title="Nuevo Ticket">
  <div class="max-w-2xl">
    <h1 class="text-2xl font-bold text-white mb-6">Crear Ticket de Soporte</h1>

    {result?.error && (
      <div class="mb-4 p-4 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 text-sm">
        {result.error.message}
      </div>
    )}

    <form method="POST" action={actions.pqrs.createTicket} class="space-y-5">
      <div>
        <label for="type" class="block text-sm font-medium text-slate-300 mb-2">
          Tipo de solicitud
        </label>
        <select
          id="type"
          name="type"
          required
          class="w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-lg text-white focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none"
        >
          <option value="petition">Petición</option>
          <option value="complaint">Queja</option>
          <option value="claim">Reclamo</option>
          <option value="suggestion">Sugerencia</option>
        </select>
      </div>

      <div>
        <label for="subject" class="block text-sm font-medium text-slate-300 mb-2">
          Asunto
        </label>
        <input
          type="text"
          id="subject"
          name="subject"
          required
          minlength="3"
          placeholder="Describe brevemente tu solicitud"
          class="w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none"
        />
      </div>

      <div>
        <label for="description" class="block text-sm font-medium text-slate-300 mb-2">
          Descripción
        </label>
        <textarea
          id="description"
          name="description"
          required
          minlength="10"
          rows="5"
          placeholder="Explica con detalle tu petición, queja, reclamo o sugerencia"
          class="w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none resize-y"
        ></textarea>
      </div>

      <div class="flex gap-3">
        <button
          type="submit"
          class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-medium rounded-lg transition-colors"
        >
          Enviar ticket
        </button>
        <a
          href="/dashboard/support"
          class="px-6 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium rounded-lg transition-colors"
        >
          Cancelar
        </a>
      </div>
    </form>
  </div>
</Dashboard>
