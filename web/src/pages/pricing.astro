---
import Base from '../layouts/Base.astro';
import PricingByCountry from '../components/PricingByCountry.astro';

export const prerender = true;
---

<Base title="Planes y Precios">
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-center mb-4">Planes y Precios</h1>
      <p class="text-slate-300 text-center mb-12 max-w-2xl mx-auto">
        Elige el plan que mejor se adapte a tu institución. Todos los planes incluyen actualizaciones gratuitas y sincronización en la nube.
      </p>

      <PricingByCountry server:defer>
        <div slot="fallback" class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="rounded-xl border border-slate-700 bg-slate-900/50 p-8 animate-pulse">
            <div class="h-6 w-20 bg-slate-700 rounded mb-4"></div>
            <div class="h-8 w-32 bg-slate-700 rounded mb-6"></div>
            <div class="space-y-3">
              <div class="h-4 w-full bg-slate-800 rounded"></div>
              <div class="h-4 w-3/4 bg-slate-800 rounded"></div>
              <div class="h-4 w-5/6 bg-slate-800 rounded"></div>
            </div>
          </div>
          <div class="rounded-xl border border-slate-700 bg-slate-900/50 p-8 animate-pulse">
            <div class="h-6 w-20 bg-slate-700 rounded mb-4"></div>
            <div class="h-8 w-32 bg-slate-700 rounded mb-6"></div>
            <div class="space-y-3">
              <div class="h-4 w-full bg-slate-800 rounded"></div>
              <div class="h-4 w-3/4 bg-slate-800 rounded"></div>
              <div class="h-4 w-5/6 bg-slate-800 rounded"></div>
            </div>
          </div>
          <div class="rounded-xl border border-slate-700 bg-slate-900/50 p-8 animate-pulse">
            <div class="h-6 w-20 bg-slate-700 rounded mb-4"></div>
            <div class="h-8 w-32 bg-slate-700 rounded mb-6"></div>
            <div class="space-y-3">
              <div class="h-4 w-full bg-slate-800 rounded"></div>
              <div class="h-4 w-3/4 bg-slate-800 rounded"></div>
              <div class="h-4 w-5/6 bg-slate-800 rounded"></div>
            </div>
          </div>
        </div>
      </PricingByCountry>
    </div>
  </section>
</Base>
