---
import Base from "../layouts/Base.astro";
import PricingByCountry from "../components/PricingByCountry.astro";

export const prerender = false;
---

<Base title="Planes y Precios">
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-center mb-4">
        Planes y Precios
      </h1>
      <p class="text-slate-300 text-center mb-12 max-w-2xl mx-auto">
        Elige el plan que mejor se adapte a tu institución. Todos los planes
        incluyen actualizaciones gratuitas y sincronización en la nube.
      </p>

      <PricingByCountry />
    </div>
  </section>
</Base>
