---
import Base from "./Base.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const admin = Astro.locals.admin;

const roleBadgeColor: Record<string, string> = {
  superadmin: 'bg-red-500/20 text-red-400',
  manager: 'bg-amber-500/20 text-amber-400',
  employee: 'bg-blue-500/20 text-blue-400',
};
---

<Base title={title}>
  <div class="flex min-h-[calc(100vh-4rem)]">
    <aside class="w-64 border-r border-slate-800 bg-slate-900 p-6 hidden md:block">
      <div class="mb-8">
        <p class="text-sm text-slate-400">Panel Admin</p>
        <p class="text-emerald-400 font-medium truncate">{admin?.email}</p>
        {admin?.role && (
          <span class={`mt-1 inline-block text-xs px-2 py-0.5 rounded-full ${roleBadgeColor[admin.role] || 'bg-slate-700 text-slate-300'}`}>
            {admin.role}
          </span>
        )}
      </div>
      <nav class="space-y-2">
        <a
          href="/admin"
          class="block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition-colors"
        >
          Métricas
        </a>
        <a
          href="/admin/clients"
          class="block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition-colors"
        >
          Clientes
        </a>
        <a
          href="/admin/payments"
          class="block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition-colors"
        >
          Pagos
        </a>
        <a
          href="/admin/downloads"
          class="block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition-colors"
        >
          Descargas
        </a>
        <a
          href="/admin/pqrs"
          class="block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition-colors"
        >
          PQRS
        </a>
      </nav>
      <div class="mt-auto pt-8">
        <form method="POST" action="/api/logout">
          <button
            type="submit"
            class="text-sm text-slate-400 hover:text-red-400 transition-colors"
          >
            Cerrar sesión
          </button>
        </form>
      </div>
    </aside>
    <div class="flex-1 p-6 lg:p-8">
      <slot />
    </div>
  </div>
</Base>
