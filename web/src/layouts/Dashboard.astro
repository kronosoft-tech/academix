---
import Base from "./Base.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
---

<Base title={title}>
  <div class="flex min-h-[calc(100vh-4rem)]">
    <aside class="w-64 border-r border-slate-800 bg-slate-900 p-6 hidden md:block">
      <div class="mb-8">
        <p class="text-sm text-slate-400">Conectado como</p>
        <p class="text-emerald-400 font-medium truncate">{user?.email}</p>
      </div>
      <nav class="space-y-2">
        <a
          href="/dashboard"
          class="block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition-colors"
        >
          Resumen
        </a>
        <a
          href="/dashboard/subscription"
          class="block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition-colors"
        >
          Suscripción
        </a>
        <a
          href="/dashboard/payments"
          class="block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition-colors"
        >
          Pagos
        </a>
        <a
          href="/dashboard/support"
          class="block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition-colors"
        >
          Soporte
        </a>
      </nav>
      <div class="mt-auto pt-8">
        <form method="POST" action="/api/logout">
          <button
            type="submit"
            class="text-sm text-slate-400 hover:text-red-400 transition-colors"
          >
            Cerrar sesión
          </button>
        </form>
      </div>
    </aside>
    <div class="flex-1 p-6 lg:p-8">
      <slot />
    </div>
  </div>
</Base>
