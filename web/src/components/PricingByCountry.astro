---
import CheckoutPlans from './CheckoutPlans';
import pricingData from '../data/pricing.json';

const countryCode =
  Astro.request.headers.get("x-vercel-ip-country") ||
  Astro.request.headers.get("cf-ipcountry") ||
  Astro.request.headers.get("x-country-code") ||
  "US";

const countryPricing = pricingData.find((p) => p.country_code === countryCode);
const fallback = pricingData.find((p) => p.country_code === "US")!;
const pricing = countryPricing || fallback;
---

<CheckoutPlans
  client:load
  countryCode={countryCode}
  currencyCode={pricing.currency_code}
  currencySymbol={pricing.symbol}
  prices={pricing.prices}
  displayName={pricing.display_name}
/>
<p class="text-center text-sm text-slate-500 mt-6">
  Precios en {pricing.currency_code} para {pricing.display_name}
</p>
