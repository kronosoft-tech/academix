---
import pricingData from "../data/pricing.json";

const countryHeader =
  Astro.request.headers.get("x-vercel-ip-country") ||
  Astro.request.headers.get("cf-ipcountry") ||
  Astro.request.headers.get("x-country-code") ||
  "US";
const countryPricing = pricingData.find(
  (p) => p.country_code === countryHeader,
);

const usdFallback = {
  symbol: "$",
  currency_code: "USD",
  display_name: "Internacional",
  prices: { basic: 20, pro: 30, premium: 60 },
};
const pricing = countryPricing || usdFallback;
const { symbol, currency_code, prices } = pricing;

function formatPrice(amount: number, currencyCode: string): string {
  return new Intl.NumberFormat("es", {
    style: "currency",
    currency: currencyCode,
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  }).format(amount);
}

const plans = [
  {
    name: "Básico",
    price: prices.basic,
    badge: "Disponible ahora",
    badgeColor: "bg-emerald-600",
    features: [
      "Hasta 100 estudiantes",
      "1 usuario",
      "Reportes básicos",
      "Soporte por email",
    ],
    cta: "Comenzar",
    highlighted: false,
  },
  {
    name: "Pro",
    price: prices.pro,
    badge: "Próximamente",
    badgeColor: "bg-slate-600",
    features: [
      "Hasta 500 estudiantes",
      "5 usuarios",
      "Reportes avanzados",
      "Soporte prioritario",
      "Asistente IA",
    ],
    cta: "Notificarme",
    highlighted: true,
  },
  {
    name: "Premium",
    price: prices.premium,
    badge: "Próximamente",
    badgeColor: "bg-slate-600",
    features: [
      "Estudiantes ilimitados",
      "Usuarios ilimitados",
      "Reportes personalizados",
      "Soporte dedicado",
      "Asistente IA avanzado",
      "API acceso",
    ],
    cta: "Notificarme",
    highlighted: false,
  },
];
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
  {
    plans.map((plan) => (
      <div
        class:list={[
          "relative rounded-xl border p-8 flex flex-col",
          plan.highlighted
            ? "border-emerald-500 bg-slate-900"
            : "border-slate-700 bg-slate-900/50",
        ]}
      >
        <span
          class:list={[
            "inline-flex self-start px-3 py-1 text-xs font-medium rounded-full text-white mb-4",
            plan.badgeColor,
          ]}
        >
          {plan.badge}
        </span>
        <h3 class="text-xl font-bold text-white">{plan.name}</h3>
        <div class="mt-4 mb-6">
          <span class="text-3xl font-bold text-white">
            {formatPrice(plan.price, currency_code)}
          </span>
          <span class="text-slate-400 text-sm"> / mes</span>
        </div>
        <ul class="space-y-3 flex-1 mb-8" role="list">
          {plan.features.map((feature) => (
            <li class="flex items-center gap-2 text-sm text-slate-300">
              <svg
                class="w-4 h-4 text-emerald-400 shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                />
              </svg>
              {feature}
            </li>
          ))}
        </ul>
        <button
          class:list={[
            "w-full py-3 rounded-lg font-semibold transition-colors text-center",
            plan.highlighted
              ? "bg-emerald-600 text-white hover:bg-emerald-500"
              : "border border-slate-600 text-slate-200 hover:border-slate-400 hover:text-white",
          ]}
          disabled={plan.badge === "Próximamente"}
          aria-label={`${plan.cta} plan ${plan.name}`}
        >
          {plan.cta}
        </button>
      </div>
    ))
  }
</div>
<p class="text-center text-sm text-slate-500 mt-6">
  Precios en {currency_code} para {pricing.display_name}
</p>
