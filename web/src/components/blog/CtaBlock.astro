---
interface Props {
  trialTitle?: string;
  trialText?: string;
}

const {
  trialTitle = "Prueba Academix gratis",
  trialText = "Configura tu academia en minutos y empieza a gestionar estudiantes, cursos y pagos desde hoy. Sin tarjeta de crédito.",
} = Astro.props;
---

<section class="mt-12 rounded-2xl border border-emerald-800/40 bg-gradient-to-br from-emerald-950/60 to-slate-900/60 p-8 sm:p-10">
  <div class="max-w-2xl">
    <h2 class="text-2xl font-bold text-white">{trialTitle}</h2>
    <p class="mt-3 text-slate-300">{trialText}</p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a
        href="/auth/register"
        class="inline-flex items-center justify-center rounded-xl bg-emerald-500 px-6 py-3 font-semibold text-slate-950 transition-colors hover:bg-emerald-400"
      >
        Probar gratis
      </a>
      <a
        href="/guias/guia-gestion-academica.md"
        class="inline-flex items-center justify-center rounded-xl border border-emerald-700/60 px-6 py-3 font-semibold text-emerald-300 transition-colors hover:bg-emerald-900/40"
      >
        Descargar guía de gestión académica
      </a>
    </div>
  </div>
</section>