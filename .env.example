# Academix Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ==============================================================================
# ADMIN CREDENTIALS (REQUIRED for production)
# ==============================================================================
# Admin email for the initial admin user
ADMIN_EMAIL=admin@academix.com

# Admin password bcrypt hash
# Generate with: bunx bcryptjs hash-password <your-password>
# Default hash (password: admin123) - DO NOT USE IN PRODUCTION:
# $2b$12$gghetCr2w7EqfgK5u8jMru4Malw8kQZcXMUQfp2dwOsac2xlo5gYy
ADMIN_PASSWORD_HASH=$2b$12$gghetCr2w7EqfgK5u8jMru4Malw8kQZcXMUQfp2dwOsac2xlo5gYy

# ==============================================================================
# APPLICATION (REQUIRED)
# ==============================================================================
# Unique identifier for this installation
APP_IDENTIFIER=com.luiferdev.academix

# ==============================================================================
# DATABASE (OPTIONAL - defaults to app data directory)
# ==============================================================================
# Full path to the SQLite database file
# DATABASE_URL=/path/to/custom/academix.db

# ==============================================================================
# TURSO (required for Turso/Control Plane features)
# ==============================================================================
# Turso control plane database URL (get from https://cloud.turso.tech)
# Example: libsql://your-db-name-your-org.turso.io
# CONTROL_PLANE_DB_URL=

# Turso control plane database token (generate in Turso dashboard)
# CONTROL_PLANE_DB_TOKEN=

# Turso API token (generate at https://cloud.turso.tech/settings/tokens)
# TURSO_API_TOKEN=

# Turso organization name (your org slug in Turso)
# TURSO_ORG=
